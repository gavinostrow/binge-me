# Copy this file to .env.local and fill in the values.
# The app runs on sample data until these are set.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# TMDB → Settings → API → "API Read Access Token" (preferred) or the v3 API key
TMDB_READ_TOKEN=
TMDB_API_KEY=
